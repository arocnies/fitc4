{
  "name": "@arocnies/fitc4",
  "version": "0.1.0",
  "description": "Check an implementation against a LikeC4 architecture contract",
  "license": "MIT",
  "author": "Aaron Nies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arocnies/fitc4.git",
    "directory": "packages/fitc4"
  },
  "homepage": "https://github.com/arocnies/fitc4#readme",
  "bugs": "https://github.com/arocnies/fitc4/issues",
  "keywords": [
    "architecture",
    "likec4",
    "c4",
    "dependency-rules",
    "lint",
    "boundaries"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  },
  "bin": {
    "fitc4": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "check": "npm run model:validate && npm run format:check && npm run typecheck && npm run build && npm run test && npm run fitc4",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "model:validate": "likec4 validate arch",
    "format:check": "likec4 format --check arch",
    "fitc4": "node dist/cli.js"
  },
  "dependencies": {
    "likec4": "^1.59.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "vitest": "^4.1.10"
  }
}
