specification {
  element person {
    style {
      shape person
    }
  }
  element system
  element container
  element component
}

model {
  // Context elements carry no `sources`, so the gate ignores them: they are
  // documentation. Only elements with `sources` are enforced against the code.
  developer = person 'Developer' {
    description 'Runs fitc4 locally or in CI'
  }

  consumer = system 'Consumer project' {
    description 'A repository that adopted fitc4: source code, an arch/ model, and a fitc4.config'
  }

  likec4 = system 'LikeC4' {
    description 'Parses the arch/ model, validates it, and computes the element graph'
    metadata {
      packages 'likec4'
    }
  }

  fitc4 = system 'FitC4' {
    lib = container 'Library & CLI' {
      core = component 'Core' {
        description 'Config, pipeline, model access, reporting, provider composition, and the CLI'
        metadata {
          sources 'src/**'
        }
      }

      providers = component 'Providers' {
        description 'The standard scan, resolve, and validate providers'
        metadata {
          sources 'src/providers/**'
        }
      }

      ai = component 'AI Providers' {
        description 'AI-assisted providers over local agent CLIs (fitc4/ai entry point)'
        metadata {
          sources 'src/ai/**'
        }
      }
    }
  }

  developer -> fitc4.lib 'runs npx fitc4'
  fitc4.lib -> consumer 'discovers fitc4.config, scans source files'
  fitc4.lib -> likec4 'loads the architecture model through'
  likec4 -> consumer 'parses arch/'

  fitc4.lib.core -> fitc4.lib.providers 'composes and re-exports (defaults.ts, index.ts)'
  fitc4.lib.providers -> fitc4.lib.core 'reads the shared contracts (types, model, ids, kinds)'
  fitc4.lib.ai -> fitc4.lib.core 'reads the shared contracts; nothing in core imports it back'
}

views {
  // Landing view: fitc4 in context.
  view index {
    title 'FitC4 landscape'
    include developer, fitc4, consumer, likec4
    autoLayout TopBottom
  }

  view fitc4 of fitc4 {
    include *
    autoLayout TopBottom
  }

  view lib of fitc4.lib {
    include *
    autoLayout TopBottom
  }

  // Behavioral: the four-phase check run, in order. Steps here are narrative
  // and need no declared relationships.
  dynamic view check {
    title 'How a check runs'
    developer -> fitc4.lib.core 'runs npx fitc4'
    fitc4.lib.core -> consumer 'discovers fitc4.config, walking up from cwd'
    fitc4.lib.core -> likec4 'validates arch/ and computes the model (fails fast on model errors)'
    fitc4.lib.core -> fitc4.lib.providers 'scan: emit file and dependency observations'
    fitc4.lib.core -> fitc4.lib.providers 'resolve: map observations onto model elements via sources'
    fitc4.lib.core -> fitc4.lib.providers 'validate: judge crossings against declared relationships'
    fitc4.lib.core -> developer 'report findings; exit non-zero on errors'
    autoLayout TopBottom
  }
}
