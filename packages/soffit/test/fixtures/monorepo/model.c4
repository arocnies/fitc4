specification {
  element system
  element component
}

model {
  fixture = system 'Fixture' {
    app = component 'App' {
      metadata {
        sources 'src/**'
      }
    }

    lib = component 'Lib' {
      metadata {
        sources 'packages/lib/**'
      }
    }
  }
}

views {
  view index of fixture {
    include *
  }
}
