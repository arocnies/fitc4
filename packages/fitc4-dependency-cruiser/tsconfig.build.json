{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    // The sources import each other with `.ts` extensions, which Node strips
    // natively but a published package cannot rely on consumers having. This
    // rewrites them to `.js` on the way out.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
