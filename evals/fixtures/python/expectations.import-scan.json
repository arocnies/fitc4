{
  "providersMust": [
    "import-scan",
    "source-root",
    "architecture-rules"
  ],
  "findings": [
    {
      "provider": "architecture-rules",
      "ruleId": "missing-relationship",
      "severity": "error",
      "subject": {
        "kind": "element",
        "id": "app.api"
      },
      "related": [
        "app.store"
      ],
      "label": "the planted api -> store import is forbidden by the model"
    }
  ],
  "observations": {
    "must": [
      {
        "provider": "import-scan",
        "kind": "scan-root",
        "subject": "src",
        "label": "the crawler attests to the root it walked"
      },
      {
        "provider": "import-scan",
        "kind": "file",
        "subject": "src/app/api/routes.py"
      },
      {
        "provider": "import-scan",
        "kind": "file",
        "subject": "src/app/core/engine.py"
      },
      {
        "provider": "import-scan",
        "kind": "file",
        "subject": "src/app/store/db.py",
        "label": "the store is found even though it imports nothing local"
      },
      {
        "provider": "import-scan",
        "kind": "dependency",
        "subject": "src/app/api/routes.py",
        "target": "src/app/core/engine.py"
      },
      {
        "provider": "import-scan",
        "kind": "dependency",
        "subject": "src/app/api/routes.py",
        "target": "src/app/store/db.py",
        "label": "the crawler reports the forbidden api -> store import"
      },
      {
        "provider": "import-scan",
        "kind": "dependency",
        "subject": "src/app/core/engine.py",
        "target": "src/app/store/db.py"
      },
      {
        "provider": "import-scan",
        "kind": "dependency",
        "subject": "src/app/core/engine.py",
        "target": "yaml",
        "label": "the external yaml package is reported as a module target"
      }
    ],
    "mustNot": [
      {
        "provider": "import-scan",
        "kind": "dependency",
        "target": "json",
        "label": "the standard-library json import was reported; the crawler must be as quiet as the agent"
      },
      {
        "provider": "import-scan",
        "kind": "dependency",
        "target": "typing",
        "label": "the standard-library typing import was reported; the crawler must be as quiet as the agent"
      },
      {
        "provider": "import-scan",
        "kind": "dependency",
        "target": "pathlib",
        "label": "the standard-library pathlib import was reported; the crawler must be as quiet as the agent"
      }
    ]
  },
  "associations": {
    "must": [
      {
        "provider": "source-root",
        "source": "app.api",
        "target": "app.core",
        "declared": true,
        "label": "the permitted api -> core import resolves onto the declared relationship"
      },
      {
        "provider": "source-root",
        "source": "app.core",
        "target": "app.store",
        "declared": true,
        "label": "the permitted core -> store import resolves onto the declared relationship"
      },
      {
        "provider": "source-root",
        "source": "app.core",
        "target": "app.vendor",
        "declared": true,
        "label": "the yaml import resolves onto the vendor element through its package claim"
      }
    ]
  }
}
