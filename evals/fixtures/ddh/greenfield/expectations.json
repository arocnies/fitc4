{
  "providersMust": [
    "typescript-imports",
    "source-root",
    "agent-resolve",
    "architecture-rules"
  ],
  "findings": [
    {
      "provider": "architecture-rules",
      "ruleId": "unobserved-elements",
      "severity": "info",
      "related": [
        "vendor.postgres"
      ],
      "label": "the description-only PostgreSQL element is reported as unobserved"
    },
    {
      "provider": "architecture-rules",
      "ruleId": "circular-dependency",
      "severity": "warning",
      "subject": {
        "kind": "element",
        "id": "ddh.libs.api"
      },
      "related": [
        "ddh.libs.api",
        "ddh.libs.application",
        "ddh.libs.ddd"
      ],
      "descriptionIncludes": "ddh.libs.api -> ddh.libs.ddd -> ddh.libs.application -> ddh.libs.api",
      "label": "the libs layer cycle the transcribed dependency-cruiser rules permit"
    },
    {
      "provider": "architecture-rules",
      "ruleId": "circular-dependency",
      "severity": "warning",
      "subject": {
        "kind": "element",
        "id": "ddh.user.commands"
      },
      "related": [
        "ddh.user.commands",
        "ddh.user.database",
        "ddh.user.wiring"
      ],
      "descriptionIncludes": "ddh.user.commands -> ddh.user.database -> ddh.user.wiring -> ddh.user.commands",
      "label": "the user module's commands/database/wiring cycle, declared and exercised"
    },
    {
      "provider": "architecture-rules",
      "ruleId": "circular-dependency",
      "severity": "warning",
      "subject": {
        "kind": "element",
        "id": "ddh.wallet.application"
      },
      "related": [
        "ddh.wallet.application",
        "ddh.wallet.database",
        "ddh.wallet.wiring"
      ],
      "descriptionIncludes": "ddh.wallet.application -> ddh.wallet.database -> ddh.wallet.wiring -> ddh.wallet.application",
      "label": "the wallet module's application/database/wiring cycle, declared and exercised"
    }
  ],
  "associations": {
    "must": [
      {
        "provider": "agent-resolve",
        "source": "ddh.libs.application",
        "target": "vendor.postgres",
        "candidateId": "ddh.libs.application=>slonik",
        "declared": true,
        "label": "slonik from the request context is mapped onto PostgreSQL, backed by ddh -> vendor"
      },
      {
        "provider": "agent-resolve",
        "source": "ddh.libs.db",
        "target": "vendor.postgres",
        "candidateId": "ddh.libs.db=>slonik",
        "declared": true,
        "label": "slonik from the repository base is mapped onto PostgreSQL, backed by ddh -> vendor"
      },
      {
        "provider": "agent-resolve",
        "source": "ddh.user.database",
        "target": "vendor.postgres",
        "candidateId": "ddh.user.database=>slonik",
        "declared": true,
        "label": "slonik from the user repository is mapped onto PostgreSQL, backed by ddh -> vendor"
      },
      {
        "provider": "agent-resolve",
        "source": "ddh.user.queries",
        "target": "vendor.postgres",
        "candidateId": "ddh.user.queries=>slonik",
        "declared": true,
        "label": "slonik from the query handler is mapped onto PostgreSQL, backed by ddh -> vendor"
      },
      {
        "provider": "agent-resolve",
        "source": "ddh.wallet.database",
        "target": "vendor.postgres",
        "candidateId": "ddh.wallet.database=>slonik",
        "declared": true,
        "label": "slonik from the wallet repository is mapped onto PostgreSQL, backed by ddh -> vendor"
      }
    ],
    "mustNot": [
      {
        "provider": "agent-resolve",
        "candidateId": "ddh.libs.application=>nanoid",
        "label": "nanoid was mapped although no vendor element covers an id generator; abstention is correct"
      }
    ]
  }
}
