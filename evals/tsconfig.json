{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "run.ts",
    "harness/**/*.ts",
    "fixtures/*/fitc4.eval.ts",
    "fixtures/*/*/fitc4.eval.ts",
    "fixtures/*/*/draft.eval.ts"
  ]
}
