{
  "name": "fitc4-repo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "packages/*",
    "example",
    "evals"
  ],
  "scripts": {
    "prepare": "npm run build --workspaces --if-present",
    "verify": "npm run check --workspaces",
    "smoke": "bash scripts/smoke.sh",
    "eval": "node evals/run.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
